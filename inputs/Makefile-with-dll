WARNING_FLAGS = -Wall -Wextra -Wpedantic -Werror
CXXFLAGS = -std=c++17 $(WARNING_FLAGS)
# Source file and executable name
SRC = main.C
EXE = main

# adding include to look in the conda environment
#INCLUDE_PATH = -I$(CONDA_PREFIX)/include
INCLUDE_PATH = -Izig-out/include
# link instructions to look in the conda environment
LIBRARY_PATH = -Lzig-out/lib

YAML_LINK = -lyaml-cpp
INPUT_LINK = -linputs
LINKS = $(YAML_LINK) $(INPUT_LINK)

# build main with the rest of the code as a dll
$(EXE):
	@echo "Building $(EXE)"
	@$(CXX) -B$(CONDA_PREFIX)/bin $(CXXFLAGS) $(INCLUDE_PATH) $(LIBRARY_PATH) $(SRC) -o $(EXE) $(LINKS) -Wl,-rpath,zig-out/lib
	@echo "$(EXE) built successfully!"
# clean up the parser
clean:
	@rm -rf *.dSYM
	@rm -f $(EXE)
